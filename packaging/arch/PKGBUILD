# Builds Exceeded from this source checkout:
#   cd packaging/arch && makepkg -si
pkgname=exceeded
pkgver=1.14.1
pkgrel=1
pkgdesc="Clean-room engine that plays Super Solvers: OutNumbered! from your own copy of the game"
arch=(x86_64 aarch64)
url="https://github.com/jpsutton/exceeded"
# No license has been chosen for the project yet; the bundled SoundFont is under its own (see licenses/).
license=(custom)
depends=(sdl2 fluidsynth zlib)
makedepends=(gcc make pkgconf)
options=(!debug)

_srcroot="$(realpath "${startdir}/../..")"

build() {
  cd "${_srcroot}"
  make clean
  make
}

package() {
  cd "${_srcroot}"
  make install DESTDIR="${pkgdir}" PREFIX=/usr
}
